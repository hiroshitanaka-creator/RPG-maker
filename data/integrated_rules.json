  "enemy_rules": [
    {
      "id": "conductor",
      "name": "導電装甲",
      "armor_defense": 60,
      "electric_defense": 20,
      "charge": true,
      "device": "armor",
      "device_hp": 45,
      "facts": [
        "装甲は電気を通すと抵抗が弱まる。",
        "調整器を壊しても装甲は開く。"
      ],
      "hypothesis": "導電付与か調整器への攻撃で、物理攻撃が通る。"
    },
    {
      "id": "charger",
      "name": "充填機構",
      "armor_defense": 45,
      "charge": true,
      "device": "armor",
      "device_hp": 40,
      "facts": [
        "封緘のある相手は充填の開始でも封緘が進む。",
        "3段階で予定行動が止まり、装甲が崩れる。"
      ],
      "hypothesis": "封緘を重ねるか調整器を壊して、攻撃の機会を作る。"
    },
    {
      "id": "reflector",
      "name": "反射装置",
      "field": true,
      "facts": [
        "場は1ラウンドの予告後に作動する。",
        "射撃を使うのは敵も同じ。近接・魔法は弱まらない。"
      ],
      "hypothesis": "装置を壊す、攻撃区分を替える、敵の射撃を抑える使い方を比べる。"
    },
    {
      "id": "mixed",
      "name": "混成の予兆",
      "magic": true,
      "facts": [
        "強い予兆は物理と魔法で別の軽減が必要。",
        "護衛は単体物理だけを引き受ける。"
      ],
      "hypothesis": "対象と攻撃区分を見て、護衛・偏向防御を分担する。"
    },
    {
      "id": "attrition",
      "name": "連続局面",
      "phase_round": 3,
      "magic": true,
      "facts": [
        "3ラウンド目に機構の局面が変わる。",
        "局面が変わっても味方のMPと付与は持ち越す。"
      ],
      "hypothesis": "前半の出力と後半に残すMPを分けて考える。"
    },
    {
      "id": "residue",
      "name": "残留する反応",
      "death_burst": 25,
      "facts": [
        "倒れたあとにも残留反応が続く。",
        "残留解除を先に使えば反応は消える。"
      ],
      "hypothesis": "解除するか、残留にも耐えられるHPと防御を用意する。"
    }
  ]
